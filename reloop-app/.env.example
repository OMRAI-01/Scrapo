# Public client configuration. Safe to expose in the browser.
# Leave these blank while the interface runs on prototype samples.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix this with NEXT_PUBLIC_, and never import it
# from a Client Component. The prototype does not read it.
# SUPABASE_SECRET_KEY=
